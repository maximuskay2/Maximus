# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=maximus
MAXIMUS_BIND_ADDRESS=127.0.0.1
MAXIMUS_HTTP_PORT=8080
# Leave empty to use http://localhost:${MAXIMUS_HTTP_PORT:-8080}.
MAXIMUS_PUBLIC_URL=
# Leave empty to inherit MAXIMUS_PUBLIC_URL.
MAXIMUS_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set MAXIMUS_PUBLIC_URL to https:// followed by the same hostname.
# Requires MAXIMUS_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
MAXIMUS_HTTPS_HOST=
MAXIMUS_BASE_IMAGE=ghcr.io/RELEASE_OWNER/maximus:latest
MAXIMUS_LOCAL_IMAGE=maximus-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
MAXIMUS_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
MAXIMUS_DATA_EXTERNAL=false
