{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "maximus-composio",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "COMPOSIO_API_BASE": "https://backend.composio.dev/api/v3.1",
    "COMPOSIO_TOOLKIT_BASE": "https://backend.composio.dev/api/v3",
    "REGISTRATION_MODE": "open"
  },
  "secrets": { "required": ["COMPOSIO_API_KEY"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maximus-composio",
      "database_id": "12041390-0fed-406d-bf6e-a178beec4293",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "REGISTRATION_LIMITER", "namespace_id": "1000001", "simple": { "limit": 30, "period": 60 } },
    { "name": "SESSION_LIMITER", "namespace_id": "1000002", "simple": { "limit": 120, "period": 60 } },
    { "name": "EVENTS_LIMITER", "namespace_id": "1000003", "simple": { "limit": 60, "period": 60 } }
  ],
  // Hourly: expire app events older than 7 days, pause the triggers of installations idle for 14 days.
  "triggers": { "crons": ["23 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
