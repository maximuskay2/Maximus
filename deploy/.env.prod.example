# Production environment for deploy/compose.prod.yml. Copy to .env.prod (staging:
# .env.staging with DOMAIN=staging.<MAXIMUS_DOMAIN>) and fill the placeholders.
# Never commit the filled file — secrets travel by environment/files only.
COMPOSE_PROJECT_NAME=maximus-prod

# GitHub owner of the release repo (contracts s8: <RELEASE_OWNER>/Maximus).
RELEASE_OWNER=
# Image tag to run, e.g. 0.1.0 or a digest. Staging uses `staging`.
MAXIMUS_VERSION=
# Public hostname Caddy serves, e.g. app.example.com (no scheme, no path).
DOMAIN=

# Who may sign in with an emailed code at /pair. Empty means pairing codes only.
MAXIMUS_SIGNIN_EMAILS=
MAXIMUS_SIGNIN_MEMBER_EMAILS=
# Mail server that sends the codes.
MAXIMUS_SIGNIN_SMTP_URL=
MAXIMUS_SIGNIN_SMTP_FROM=

# Space-separated engine CLIs baked into a from-source image build.
ENGINES="@anthropic-ai/claude-code @openai/codex"

# Backup sidecar: cron schedule + snapshot retention in days.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
