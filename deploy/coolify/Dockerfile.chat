# Chat harness image for Coolify Traefik. Expects dist/ and dist-server/
# already built on the host (pnpm build && pnpm build:server).
FROM node:24-bookworm-slim
WORKDIR /app
# Chrome/agent-browser libs (same set as the root Dockerfile runtime stage).
# agent-browser --with-deps wants sudo; install packages directly instead.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git \
    libxcb-shm0 libx11-xcb1 libx11-6 libxcb1 libxext6 libxrandr2 \
    libxcomposite1 libxcursor1 libxdamage1 libxfixes3 libxi6 libgtk-3-0 \
    libpangocairo-1.0-0 libpango-1.0-0 libatk1.0-0 libcairo-gobject2 \
    libcairo2 libgdk-pixbuf-2.0-0 libxrender1 libasound2 libfreetype6 \
    libfontconfig1 libdbus-1-3 libnss3 libnss3-tools libnspr4 \
    libatk-bridge2.0-0 libdrm2 libxkbcommon0 libatspi2.0-0 libcups2 \
    libxshmfence1 libgbm1 libglib2.0-0 fonts-noto-color-emoji fonts-noto-cjk fonts-freefont-ttf \
  && rm -rf /var/lib/apt/lists/*
COPY dist-server /app/dist-server
COPY dist /app/dist
RUN mkdir -p /data
ENV NODE_ENV=production
ENV MAXIMUS_STATIC_DIR=/app/dist
EXPOSE 8799 8800
# Volume /data is root-owned on first mount; Traefik terminates TLS outside.
CMD ["node", "/app/dist-server/maximus.js", "serve", "--port", "8799", "--data-dir", "/data", "--no-pair"]
